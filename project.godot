; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="GodotVinoKit"
config/description="基于Godot引擎开发的组件和插件库"
config/tags=PackedStringArray("demo")
run/main_scene="res://addons/vinokit/modules/vino_video_player/video_player.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/show_image=false
config/icon="uid://b5pt8eyhh83e0"

[autoload]

VinoConfig="*uid://dbx3u85qdaqtj"
VinoAssets="*uid://tuop8a38kctm"
VinoData="*uid://bi7usc7grjafd"
VinoWindow="*uid://dim0wegwqd86"

[display]

window/size/viewport_width=1720
window/size/viewport_height=720
window/size/borderless=true

[editor_plugins]

enabled=PackedStringArray("res://addons/vinokit/plugin.cfg")

[file_customization]

folder_colors={
"res://addons/license/": "red",
"res://addons/vinokit/": "green"
}

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
